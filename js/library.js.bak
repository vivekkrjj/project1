(function(){
const $=id=>document.getElementById(id), esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
let rows=[], studentCourse='', dbChapters=[];
async function secureUrl(v){if(!v)return '';if(!String(v).startsWith('storage:'))return v;const path=String(v).slice(8);const {data,error}=await bhumiDb.storage.from('library-files').createSignedUrl(path,3600,{download:true});return error?'':data?.signedUrl||''}
function catalog(){return (window.BHUMI_CHAPTER_CATALOG||[]).filter(x=>x.course===studentCourse)}
function fillSubjects(){const sem=$('semester').value;const subs=[...new Set(catalog().filter(x=>!sem||x.semester===sem).map(x=>x.subject))].sort();$('subject').innerHTML='<option value="">All Subjects</option>'+subs.map(x=>`<option>${esc(x)}</option>`).join('')}
function chapterMatches(c,q,sem,sub){return (!sem||c.semester===sem)&&(!sub||c.subject===sub)&&(!q||[c.subject,c.chapter_title,c.year,c.semester||''].join(' ').toLowerCase().includes(q))}
async function render(){const q=$('search').value.trim().toLowerCase(),sem=$('semester').value,sub=$('subject').value,year=$('year').value;const mats=rows.filter(r=>(!year||r.year_level===year));const cats=catalog().filter(c=>(!year||c.year===year)&&chapterMatches(c,q,sem,sub));const box=$('chapterGrid');if(!cats.length){box.innerHTML='<div class="empty"><h3>No chapter found</h3><p>Try another year, semester, subject or search term.</p></div>';return}
const byKey=new Map();mats.forEach(m=>{if(m.chapter_id)byKey.set(String(m.chapter_id),[...(byKey.get(String(m.chapter_id))||[]),m])});const dbByKey=new Map(dbChapters.map(d=>[`${d.course}|${d.year_level}|${d.semester||''}|${d.subject}|${d.chapter_no}`,d]));
box.innerHTML=cats.map((c,i)=>{const d=dbByKey.get(`${c.course}|${c.year}|${c.semester||''}|${c.subject}|${c.no}`);const linked=d?rows.filter(m=>String(m.chapter_id)===String(d.id)):[];return `<article class="material-card"><div class="material-meta"><span>${esc(c.course)}</span><span>${esc(c.year)}</span>${c.semester?`<span>${esc(c.semester)}</span>`:''}</div><h3>Chapter ${c.no}: ${esc(c.chapter_title)}</h3><strong>${esc(c.subject)}</strong><p>${linked.length?linked.length+' study resource(s) available.':'Chapter structure ready — study material can be added by the college admin.'}</p><div class="material-actions">${linked.map((r,j)=>`<a class="primary-btn mat-link" data-key="${esc(r.id)}" href="${r.external_url?esc(r.external_url):'#'}" ${r.external_url?'target="_blank" rel="noopener"':''}>${esc(r.title)}</a>${r.file_url?`<a class="outline-btn file-link" data-id="${esc(r.id)}" href="#">PDF / File</a>`:''}`).join('')||'<span class="muted">📚 Material pending upload</span>'}</div></article>`}).join('');
for(const a of box.querySelectorAll('.file-link')){const r=rows.find(x=>String(x.id)===String(a.dataset.id));if(r){const u=await secureUrl(r.file_url);if(u)a.href=u;else a.textContent='File unavailable';}}
}
async function load(){try{if(!isDbReady())throw new Error('Supabase is not configured.');const {data:{session}}=await bhumiDb.auth.getSession();if(!session)throw new Error('Please login as an approved student to access your course library.');const {data:reg,error:regError}=await bhumiDb.from('student_registration_requests').select('course,status,full_name').eq('user_id',session.user.id).eq('status','approved').order('created_at',{ascending:false}).limit(1).maybeSingle();if(regError)throw regError;if(!reg)throw new Error('Your student account is not approved yet.');studentCourse=reg.course||'';$('courseBadge').textContent=studentCourse+' Chapter Library';$('courseBadge').classList.remove('hidden');$('course').value=studentCourse;$('course').disabled=true;const {data,error}=await bhumiDb.from('library_materials').select('*').eq('is_active',true).in('course',[studentCourse,'All Nursing']).order('sort_order',{ascending:true}).order('created_at',{ascending:false});if(error)throw error;rows=data||[];const ch=await bhumiDb.from('library_chapters').select('*').eq('is_active',true).eq('course',studentCourse).order('sort_order',{ascending:true});if(ch.error)throw ch.error;dbChapters=ch.data||[];const years=[...new Set(catalog().map(x=>x.year).filter(Boolean))];$('year').innerHTML='<option value="">All Years</option>'+years.map(y=>`<option>${esc(y)}</option>`).join('');fillSubjects();await render()}catch(e){$('chapterGrid').innerHTML=`<div class="empty"><h3>Library Access</h3><p>${esc(e.message)}</p><a href="student.html" class="primary-btn" style="text-decoration:none">← Student Portal</a></div>`}}
['search','semester','subject','year'].forEach(id=>$(id).addEventListener('input',()=>{if(id==='semester')fillSubjects();render()}));load();
})();
